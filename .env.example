# 复制本文件为 .env 并填写真实值（.env 已被 .gitignore 忽略，不会提交到仓库）
# 切勿将真实凭据粘贴到聊天、文档或代码中

# ---- MySQL 数据库（请使用只读账号，不要用 root）----
DB_HOST=192.168.10.114
DB_USER=qa_ro
DB_PASSWORD=<只读账号密码>
DB_NAME=visionanalysis
DB_PORT=3306
DB_SSL_DISABLED=true
# 只读查询的会话级超时（毫秒，MySQL 5.7.8+），防止慢查询长期占用连接
QUERY_TIMEOUT_MS=15000
# 建连超时（秒）：数据库不可达时每次工具调用的最大等待；
# 设短一点（如 5）可在网络不通时更快向用户报错而不是长时间转圈
DB_CONNECT_TIMEOUT=10
# schema 元数据缓存时长（秒）：表结构低频变化，缓存可减少 information_schema 往返；0 表示禁用
SCHEMA_CACHE_TTL=300

# ---- 大模型 ----
LLM_API_KEY=sk-xxxxxx
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=60

# ---- Web 服务 ----
# 会话签名密钥：至少 32 位随机字符串（必填，缺失时服务拒绝启动），可用
# python -c "import secrets; print(secrets.token_hex(32))" 生成
SESSION_SECRET_KEY=<32位以上随机字符串>
# 部署到 HTTPS 后改为 true，使会话 cookie 仅经加密连接传输
SESSION_COOKIE_SECURE=false
# 接口限流：每个 IP 每分钟最多请求次数
RATE_LIMIT_ASK=20
RATE_LIMIT_NEW_CHAT=10
RATE_LIMIT_FEEDBACK=30
# API 认证（P3-19）：逗号分隔的密钥列表；设置后 /api/v1/* 请求须携带
# X-API-Key 请求头，留空则完全开放（本地开发默认）。前端页面遇 401 会
# 弹窗提示输入并保存于浏览器 localStorage
WEB_API_KEYS=
WEB_HOST=127.0.0.1
WEB_PORT=5000

# ---- 会话历史存储 ----
# memory：进程内存（默认，单 worker）；redis：多 worker/多实例共享（需安装 redis 包）
# Redis 不可用时自动降级为 memory 并记录告警
HISTORY_BACKEND=memory
REDIS_URL=redis://127.0.0.1:6379/0
# Redis 中会话历史的过期时间（秒）；激活/回放会话时会自动续期，
# 只有彻底不再访问的会话才会过期（默认 7 天）
HISTORY_TTL_SECONDS=604800
# LLM 上下文最多保留的消息条数（最近 N 条）；两种后端均生效
HISTORY_MAX_MESSAGES=6
# 每会话完整回放（侧边栏）最多保留的消息条数，防止单会话无限增长
HISTORY_MAX_REPLAY=50

# ---- 生产部署（uvicorn，见 README「生产部署」）----
# uvicorn app:app --workers N（多 worker 前请先把 HISTORY_BACKEND 切为 redis，
# 否则同一浏览器的请求落到不同 worker 会丢失会话，建议 worker 数保持 1~2）
WEB_WORKERS=2

# ---- RAG few-shot 与业务术语表（P3-16，文件配置而非环境变量）----
# rag/examples.jsonl：问题->SQL 示例语料，每行一个 JSON（question+sql），
#                     以 # 开头的行是注释；提问时自动检索 Top-3 相似示例注入提示词
# rag/glossary.md：业务术语表，每行一条「术语: 定义」，启动时注入系统提示词
# feedback.jsonl：用户点赞/点踩记录（自动生成），点赞样本经人工核对后可
#                 回流到 rag/examples.jsonl 形成闭环（P3-18）
